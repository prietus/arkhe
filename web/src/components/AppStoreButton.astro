---
import { APP_STORE_URL } from '../data';

interface Props {
  class?: string;
  label?: string;
}

const { class: className = '' } = Astro.props;
// Until the listing is live there is nothing to link to: show a non-clickable badge.
const live = APP_STORE_URL !== '';
const label = Astro.props.label ?? (live ? 'Download on the App Store' : 'Coming soon to the App Store');
const apple =
  'M16.365 12.43c-.024-2.44 1.99-3.61 2.08-3.67-1.13-1.66-2.89-1.89-3.52-1.92-1.5-.15-2.93.88-3.7.88-.77 0-1.94-.86-3.2-.84-1.64.02-3.16.96-4 2.44-1.72 2.99-.44 7.4 1.23 9.83.82 1.18 1.8 2.51 3.08 2.46 1.23-.05 1.7-.8 3.2-.8 1.5 0 1.91.8 3.22.78 1.33-.02 2.17-1.2 2.98-2.4.94-1.38 1.33-2.73 1.35-2.8-.03-.02-2.6-1.01-2.62-3.96ZM14.1 5.14c.68-.83 1.15-1.98 1.02-3.14-.98.04-2.19.66-2.9 1.48-.64.72-1.2 1.89-1.05 3.01 1.1.08 2.22-.56 2.93-1.35Z';
---

{live ? (
  <a href={APP_STORE_URL} class:list={['btn-primary', className]} target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={apple} /></svg>
    {label}
  </a>
) : (
  <span class:list={['btn-primary cursor-default opacity-90', className]} aria-disabled="true">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={apple} /></svg>
    {label}
  </span>
)}
